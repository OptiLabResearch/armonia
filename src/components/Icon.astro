---
interface Props {
  name: 'leaf' | 'heart' | 'sun' | 'pin' | 'mail' | 'phone' | 'arrow';
}
const { name } = Astro.props;
---

<svg
  width="28"
  height="28"
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'leaf' && (
      <>
        <>
          <path d="M7 24C-1 10 16 10 25 3c3 16-2 23-13 23" />
          <path d="M6 29c3-9 8-15 16-21" />
        </>
      </>
    )
  }
  {name === 'heart' && <path d="M16 27 4 15C-3 6 10-1 16 8 22-1 35 6 28 15Z" />}
  {
    name === 'sun' && (
      <>
        <>
          <circle cx="16" cy="16" r="6" />
          <path d="M16 1v5m0 20v5M1 16h5m20 0h5M5.4 5.4 9 9m14 14 3.6 3.6M5.4 26.6 9 23M23 9l3.6-3.6" />
        </>
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <>
          <path d="M25 13c0 7-9 16-9 16S7 20 7 13a9 9 0 1 1 18 0Z" />
          <circle cx="16" cy="13" r="3" />
        </>
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <>
          <rect x="3" y="6" width="26" height="20" rx="1" />
          <path d="m4 7 12 11L28 7" />
        </>
      </>
    )
  }
  {
    name === 'phone' && (
      <path d="m8 3 5 6-4 4c2 5 5 8 10 10l4-4 6 5c-2 12-24-1-26-14 0-4 2-6 5-7Z" />
    )
  }
  {name === 'arrow' && <path d="M5 16h22m-8-8 8 8-8 8" />}
</svg>
