---
import Photo from './Photo.astro';
import BookingButton from './BookingButton.astro';
import massage from '../assets/images/massage.png';
import { price, type Treatment } from '../data/site';
interface Props {
  treatment: Treatment;
  compact?: boolean;
}
const { treatment, compact = false } = Astro.props;
---

<article
  class:list={['treatment-card', { 'treatment-card--compact': compact }]}
  id={compact ? undefined : treatment.id}
>
  <div class="treatment-photo">
    <Photo
      src={massage}
      alt="Illustrativ bild av varsamma händer under en hand- och underarmsmassage."
      sizes={compact
        ? '(min-width: 760px) 33vw, 100vw'
        : '(min-width: 760px) 50vw, 100vw'}
    />
  </div>
  <div class="treatment-copy">
    <p class="eyebrow">EN PAUS FÖR KROPPEN</p><h2>{treatment.name}</h2><p>
      {treatment.description}
    </p>
    {
      !compact && (
        <>
          <dl class="treatment-facts">
            <>
              <div>
                <>
                  <dt>Tid</dt>
                  <dd>
                    {treatment.durationMinutes
                      ? `${treatment.durationMinutes} minuter`
                      : 'Kompletteras inför öppning'}
                  </dd>
                </>
              </div>
              <div>
                <>
                  <dt>Pris</dt>
                  <dd>
                    {treatment.priceSek
                      ? price(treatment.priceSek)
                      : 'Kompletteras inför öppning'}
                  </dd>
                </>
              </div>
            </>
          </dl>
          {!treatment.confirmed && (
            <p class="editorial-note">
              Preliminär presentation. Behandlingsutbud, tider och priser är
              ännu inte fastställda.
            </p>
          )}
        </>
      )
    }
    {
      compact ? (
        <a class="text-link" href="/behandlingar/">
          Läs om behandlingar <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <BookingButton url={treatment.bookingUrl} />
      )
    }
  </div>
</article>
