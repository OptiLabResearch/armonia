---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
---

<Base
  title="Sidan hittades inte | Armonia"
  description="Den här sidan finns inte. Hitta tillbaka till Armonias startsida."
  noindex
  ><section class="not-found container narrow">
    <Mark /><p class="eyebrow">404 · EN LITEN OMVÄG</p><h1>
      Här var det <em>stilla.</em>
    </h1><p>
      Sidan du letar efter verkar inte finnas.<br />Vi hjälper dig tillbaka till
      början.
    </p><a class="button" href="/"
      >Till startsidan <span aria-hidden="true">↗</span></a
    >
  </section></Base
>
